// mortar -- the interface.
//
// **THIS FILE IS THE LIBRARY'S PUBLIC SURFACE AND IT IS ONE LINE PER COMPONENT ON PURPOSE.** slate
// has no re-export: a name a program imports has to be declared in the file it imports, which is the
// manifest's `main`. So the bodies and the stylesheets live under `parts/`, one component to a file
// with its `.css` beside it, and this is where they become the library.
//
// **A table in a README would be a description of an interface; this is the interface.** Every name
// an application can reach is on one of the lines below, so a component that stops being declared
// here stops compiling for everybody who imported it -- which is the check the table cannot make.
//
// **Every component takes an optional `class`, appended to its own**, and every one of them checks
// the props it is about to use and faults with a sentence naming the prop. Neither is repeated in
// the table below.
//
// | | props |
// |---|---|
// | `Theme` | `theme`, `onChange`, `children` -- the provider, and the `data-theme` the sheets select on |
// | `useTheme()` | `[theme, setTheme]` -- a hook, reading and writing the theme atom directly |
// | `Page` | `brand`, `brandHref`, `nav`, `search`, `footer`, `skipLabel`, `mainId`, `children` |
// | `Avatar` | `name`, `src`, `size` |
// | `Byline` | `name`, `src`, `href`, `at`, `size` |
// | `Timestamp` | `at`, `show` |
// | `Photo` | `src`, `alt` |
// | `Card` | `title`, `href`, `level`, `children` |
// | `ThreadCard` | `title`, `href`, `level`, `name`, `src`, `authorHref`, `at`, `excerpt`, `tags`, `tagHref`, `replies`, `children` |
// | `CardList` | `children` |
// | `Post` | `title`, `level`, `name`, `src`, `authorHref`, `at`, `body`, `photo`, `alt`, `tags`, `tagHref`, `compact`, `children` |
// | `PostList` | `children` |
// | `Tag` | `label`, `href`, `count`, `current`, `onChoose` |
// | `TagList` | `tags`, `href`, `current`, `onChoose` |
// | `Pagination` | `page`, `size`, `total`, `href`, `onChoose`, `unit` |
// | `Segmented` | `options`, `value`, `href`, `onChoose`, `label` |
// | `Tabs` | `tabs`, `selected`, `initial`, `onSelect`, `label`, `id` |
// | `SortControls` | `options`, `sort`, `href`, `onChoose`, `label` |
// | `EmptyState` | `title`, `detail`, `children` |
// | `Problem` | `problem`, `title`, `detail`, `status`, `errors`, `reason` |
// | `Live` | `live`, `atomic`, `children` |
// | `Toast` | `messages`, `live`, `onDismiss`, `dismissLabel` |
// | `Form` | `action`, `method`, `enctype`, `csrf`, `csrfName`, `onSubmit`, `label`, `children` |
// | `Field` | `name`, `label`, `kind`, `value`, `error`, `hint`, `required`, `placeholder`, `autocomplete`, `id`, `onInput` |
// | `TextArea` | `name`, `label`, `value`, `rows`, `error`, `hint`, `required`, `placeholder`, `id`, `onInput` |
// | `FileInput` | `name`, `label`, `accept`, `maxSize`, `error`, `hint`, `required`, `id`, `onInput` |
// | `Button` | `kind`, `variant`, `disabled`, `onClick`, `label`, `children` |
// | `Actions` | `children` |
// | `Menu` | `items`, `label`, `align`, `id` |
// | `Tooltip` | `text`, `placement`, `delay`, `id`, `children` |
// | `Confirm` | `open`, `title`, `detail`, `confirmLabel`, `cancelLabel`, `tone`, `onConfirm`, `onCancel`, `id` |
// | `VisuallyHidden` | `tag`, `children` |
//
// **`docs/components.md` is the same table with every default and every refusal**, and it is checked
// by the suite rather than kept up by hand.

import { theme, useTheme as themeHook, Themes as themeWords } from "./parts/theme.slx"
import { page } from "./parts/page.slx"
import { avatar, Sizes as sizeWords } from "./parts/avatar.slx"
import { byline, timestamp, Shows as showWords } from "./parts/byline.slx"
import { photo } from "./parts/photo.slx"
import { card, threadCard, cardList, Levels as cardLevels } from "./parts/card.slx"
import { post, postList, Levels as postLevels } from "./parts/post.slx"
import { tag, tagList } from "./parts/tags.slx"
import { pagination } from "./parts/pagination.slx"
import { segmented, sortControls } from "./parts/segmented.slx"
import { tabs } from "./parts/tabs.slx"
import { emptyState } from "./parts/empty.slx"
import { problem, reasonOf } from "./parts/problem.slx"
import { live, toast, Manner as liveWords, Tones as toneWords } from "./parts/live.slx"
import { form, Methods as formMethods } from "./parts/form.slx"
import { field, textArea, fileInput } from "./parts/field.slx"
import { button, actions, Kinds as buttonKinds, Variants as buttonVariants } from "./parts/button.slx"
import { hidden } from "./parts/hidden.slx"
import { confirm } from "./parts/confirm.slx"
import { menu } from "./parts/menu.slx"
import { tooltip } from "./parts/tooltip.slx"

// -- the theme -------------------------------------------------------------------------------------

export val Theme = theme
export val useTheme = themeHook

// -- the frame -------------------------------------------------------------------------------------

export val Page = page
export val VisuallyHidden = hidden

// -- people and moments ----------------------------------------------------------------------------

export val Avatar = avatar
export val Byline = byline
export val Timestamp = timestamp
export val Photo = photo

// -- things somebody wrote -------------------------------------------------------------------------

export val Card = card
export val ThreadCard = threadCard
export val CardList = cardList
export val Post = post
export val PostList = postList

// -- finding things --------------------------------------------------------------------------------

export val Tag = tag
export val TagList = tagList
export val Pagination = pagination
export val Segmented = segmented
export val SortControls = sortControls

// **`Tabs` is the choice that has no address**, which is what separates it from the two above: a
// sort order is part of a page's URL and several panels of one page are not. It is the library's
// only keyboard-navigated control -- arrows move along the row and select as they go.

export val Tabs = tabs

// -- what the page has to say ----------------------------------------------------------------------

export val EmptyState = emptyState
export val Problem = problem
export val Live = live
export val Toast = toast

// -- forms -----------------------------------------------------------------------------------------

export val Form = form
export val Field = field
export val TextArea = textArea
export val FileInput = fileInput
export val Button = button
export val Actions = actions

// -- a list of things to do --------------------------------------------------------------------------
//
// **`Menu` is the control for an ACTION and every other list-shaped control here is for a value.** A
// filter, a sort order and a page number are all things that stay chosen and can be changed back, so
// each of them is an anchor a page with no script still works; a menu's rows happen the moment they
// are pressed. It is the library's second keyboard-navigated control, after `Tabs`.

export val Menu = menu

// -- a note about the thing under the pointer ---------------------------------------------------------
//
// **`Tooltip` describes its trigger and holds nothing of its own.** The words in it say again, at
// more length, what the control they are attached to already says; anything only the tooltip knows is
// information a reader on a phone never sees, so it belongs in the page -- a `Field`'s `hint`, an
// `EmptyState`, a `Problem`. The note is rendered carrying `hidden` and only the SHOWING needs a
// browser, which is `Menu`'s arrangement and not `Confirm`'s.

export val Tooltip = tooltip

// -- asking before something irreversible ------------------------------------------------------------
//
// **The one component in this library that is script-only**, and the only one that renders nothing at
// all where there is no document: a modal exists to interrupt, and interrupting is something only a
// running page can do. A server's answer to a destructive action is the plain form it was always
// going to submit.

export val Confirm = confirm

// -- the words a prop may be -------------------------------------------------------------------------
//
// **Every closed set of words is exported**, so an application can render its own control over the
// same list rather than writing the three strings out again and finding out at run time that it
// spelled one of them differently.

export val Themes = themeWords
export val Sizes = sizeWords
export val Shows = showWords
export val CardLevels = cardLevels
export val PostLevels = postLevels
export val LiveManners = liveWords
export val Tones = toneWords
export val FormMethods = formMethods
export val ButtonKinds = buttonKinds
export val ButtonVariants = buttonVariants

// **The sentence one row of a problem document becomes**, exported because an application writing a
// `reason` of its own usually wants to fall back to this one for the rows it does not recognise.
export val problemReason = reasonOf
