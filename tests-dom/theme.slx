import { createElement, Fragment, mount, hydrate, html, flush, createStore, Provider } from lath
import { domHost } from lath/dom
import { Button, Theme, useTheme } from "../mortar.slx"

import { at, click, mutations, shown } from "./probe.slx"

// The theme against a real page, which is the half a string cannot answer.
//
// **EACH TEST GETS ITS OWN STORE**, the same isolation `tests/theme.slx` uses -- an atom in a fresh
// `createStore()` starts at `"light"` regardless of what an earlier test in this file did to it.

// What a page reads and what it presses.
Toggle(props: object) =
    val [now, setTheme] = useTheme()

    <Fragment>
        <p id="says">{now}</p>
        <Button label="theme" onClick={() -> setTheme(if now == "light" then "dark" else "light")}>
            {if now == "light" then "Dark" else "Light"}
        </Button>
    </Fragment>

App({ theme = null }) = <Theme theme={theme}><Toggle/></Theme>

fresh(theme = null) =
    at("")

    mount(<Provider store={createStore()}><App theme={theme}/></Provider>, domHost("#page"))

@test
async A_THEME_HANDED_IN_IS_WHAT_THE_PAGE_SHOWS()
    fresh("dark")

    assert(contains(shown(), "data-theme=\"dark\""))
    assert(contains(shown(), "<p id=\"says\">dark</p>"))

@test
async WITH_NOTHING_HANDED_IN_THE_PAGE_IS_LIGHT()
    // **No cookie, no seed, and the atom's own default is the answer.** A server with nothing in
    // the request's `Cookie` header hands `Theme` no `theme` prop at all, which is this.
    fresh()

    assert(contains(shown(), "data-theme=\"light\""))
    assert(contains(shown(), "<p id=\"says\">light</p>"))

@test
async PRESSING_THE_TOGGLE_CHANGES_THE_ATOM_AND_THE_PAGE_FOLLOWS()
    fresh()

    assert(contains(shown(), "data-theme=\"light\""))

    click("button[aria-label=\"theme\"]")

    await sleep(1)

    assert(contains(shown(), "data-theme=\"dark\""))
    assert(contains(shown(), "<p id=\"says\">dark</p>"))

    click("button[aria-label=\"theme\"]")

    await sleep(1)

    assert(contains(shown(), "data-theme=\"light\""))

@test
async CHANGING_THE_THEME_TOUCHES_THE_ONE_ATTRIBUTE_AND_THE_LABEL()
    // **What a custom property carrying the theme buys, measured.** Every colour in the library is
    // a `var(--m-…)`, so a whole page turning over is one attribute and whatever text actually
    // changed -- not a class per element and not a second stylesheet.
    fresh()

    await sleep(1)

    val before = mutations()

    click("button[aria-label=\"theme\"]")

    await sleep(1)

    // `data-theme`, the paragraph's text and the button's: three records, and nothing rebuilt.
    assertEq(mutations() - before, 3)

@test
async A_PAGE_RENDERED_DARK_ON_THE_SERVER_HYDRATES_DARK_AND_RECORDS_NOTHING()
    // **The reason the theme is seeded rather than read off `localStorage`.** A server that reads
    // the choice off the request's cookie renders the right colour the first time; a choice only
    // the browser knows makes the page flip in front of the reader.
    val sent = html(mount(<Provider store={createStore()}><App theme="dark"/></Provider>))

    assert(contains(sent, "data-theme=\"dark\""))

    at(sent)

    await sleep(1)

    val before = mutations()

    // **A different store from the server's** -- the client never sees that object, only the
    // markup and the same cookie value the server read, which is what re-seeds it here.
    hydrate(<Provider store={createStore()}><App theme="dark"/></Provider>, domHost("#page"))

    await sleep(1)

    assertEq(mutations() - before, 0)
    assert(contains(shown(), "data-theme=\"dark\""))
