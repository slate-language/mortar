import { createElement, Fragment, mount, html, flush, createStore, Provider } from lath
import { Avatar, Theme, Themes, useTheme } from "../mortar.slx"
import { themeAtom } from "../parts/theme.slx"

import { countOf, fell, tree } from "./support.sl"

// The theme: where the choice lives, and what the stylesheets select on.
//
// **THE ATOM IS THE STORE, AND EACH TEST BELOW GETS ITS OWN.** `createStore()` plus `<Provider>`
// scopes the theme atom underneath it to that store alone, so these tests need no address to reset
// between them the way the old query-string arrangement did -- an atom in its own store starts
// exactly where `atom("light")` says it does, every time.

fresh() -> object = createStore()

markup(el) -> string = tree(html(mount(<Provider store={fresh()}>{el}</Provider>)))

@test
A_THEME_WITH_NOTHING_SEEDED_IS_LIGHT()
    val out = markup(<Theme><p>x</p></Theme>)

    assertEq(out, "<div class=\"mortar\" data-theme=\"light\"><p>x</p></div>")

@test
A_THEME_HANDED_A_WORD_SEEDS_THE_ATOM_AND_RENDERS_IT()
    assert(contains(markup(<Theme theme="dark"><p>x</p></Theme>), "data-theme=\"dark\""))

@test
A_THEME_HANDED_A_WORD_WINS_OVER_AN_ATOM_ALREADY_HOLDING_THE_OTHER_ONE()
    // **The prop seeds; it does not merely default.** A store already holding "dark" -- the shape a
    // server's request-scoped store would be in from an earlier read -- still renders whatever this
    // particular `Theme` was handed.
    val store = fresh()

    store.set(themeAtom, "dark")

    val out = tree(html(mount(<Provider store={store}><Theme theme="light"><p>x</p></Theme></Provider>)))

    assert(contains(out, "data-theme=\"light\""))

@test
USE_THEME_READS_WHAT_THE_SEED_RESOLVED()
    Reader(props: object) =
        val [now, set] = useTheme()

        <p>{now}</p>

    assert(contains(markup(<Theme theme="dark"><Reader/></Theme>), "<p>dark</p>"))

@test
USE_THEME_WITH_NO_THEME_ABOVE_IT_READS_THE_ATOM_DIRECTLY()
    // **There is no fault to say, and no setter that refuses.** The atom is module-level, so a lone
    // component still has somewhere to read from and something to write to -- unlike the old context
    // form, `useTheme()` needs no `Theme` above it for either half.
    var setter = null

    Alone(props: object) =
        val [now, set] = useTheme()

        setter = set

        <p>{now}</p>

    val root = mount(<Provider store={fresh()}><Alone/></Provider>)

    assert(contains(html(root), "<p>light</p>"))

    setter("dark")
    flush(root)

    assert(contains(html(root), "<p>dark</p>"))

@test
A_THEME_TOGGLED_FROM_A_NESTED_COMPONENT_RERENDERS_BOTH()
    var setter = null

    Toggle(props: object) =
        val [now, set] = useTheme()

        setter = set

        <p>{now}</p>

    val root = mount(<Provider store={fresh()}><Theme><Toggle/></Theme></Provider>)

    assert(contains(html(root), "<p>light</p>"))

    setter("dark")
    flush(root)

    assert(contains(html(root), "<p>dark</p>"))
    assert(contains(html(root), "data-theme=\"dark\""))

    setter("light")
    flush(root)

    assert(contains(html(root), "<p>light</p>"))
    assert(contains(html(root), "data-theme=\"light\""))

@test
ONCHANGE_IS_CALLED_AFTER_MOUNT_AND_AGAIN_AFTER_EVERY_LATER_CHANGE()
    // **This is the hook a server route persists a choice through**, now that nothing here writes a
    // cookie for it -- see the README for why the client does not write one itself.
    var seen = []
    var setter = null

    took(next) =
        push(seen, next)

        null

    Toggle(props: object) =
        val [now, set] = useTheme()

        setter = set

        <p>{now}</p>

    val root = mount(<Provider store={fresh()}><Theme onChange={took}><Toggle/></Theme></Provider>)

    assertEq(seen, ["light"])

    setter("dark")
    flush(root)

    assertEq(seen, ["light", "dark"])

@test
TWO_STORES_ONE_PROGRAM_TWO_COLOURS()
    // **One atom, two values.** `createStore()` plus `<Provider>` is what a server does per request
    // so that one process rendering two of them at once gets two independent pages; a program that
    // mounts two at once, side by side, is the same guarantee measured directly.
    val lit = tree(html(mount(<Provider store={fresh()}><Theme theme="light"><p>x</p></Theme></Provider>)))
    val drk = tree(html(mount(<Provider store={fresh()}><Theme theme="dark"><p>x</p></Theme></Provider>)))

    assert(contains(lit, "data-theme=\"light\""))
    assert(contains(drk, "data-theme=\"dark\""))

@test
A_THEME_THAT_IS_NEITHER_WORD_NAMES_THE_PROP_AND_LISTS_THEM()
    val said = fell(() -> markup(<Theme theme="midnight"><p>x</p></Theme>))

    assert(contains(said, "Theme's `theme`"))
    assert(contains(said, "\"light\", \"dark\""))

@test
AN_ATOM_HOLDING_SOMETHING_THAT_IS_NOT_A_THEME_WORD_DISPLAYS_LIGHT()
    // **An atom, unlike a prop, is not something `Theme` can refuse on the caller's behalf** -- a
    // program can write anything into it through `useTheme()`'s bare setter. An unrecognised value
    // is the default, quietly, the same as the address bar's old `?theme=chartreuse` was.
    val store = fresh()

    store.set(themeAtom, "chartreuse")

    val out = tree(html(mount(<Provider store={store}><Theme><p>x</p></Theme></Provider>)))

    assertEq(out, "<div class=\"mortar\" data-theme=\"light\"><p>x</p></div>")

@test
THE_TWO_WORDS_ARE_EXPORTED_SO_AN_APPLICATION_NEED_NOT_WRITE_THEM_OUT()
    assertEq(Themes, ["light", "dark"])

@test
THE_TOKENS_CARRY_BOTH_THEMES_AND_A_BARE_COMPONENT_STILL_HAS_THEM()
    // **The `:root` block is what makes a single component work on its own** -- an `<Avatar/>` with
    // no `Theme` above it still has the names its rules read.
    val alone = html(mount(<Avatar name="A"/>))

    assert(contains(alone, ":root {"))
    assert(contains(alone, "[data-theme=\"dark\"]"))
    assert(contains(alone, "color-scheme: dark"))
