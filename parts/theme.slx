// The theme: a value in an atom outside any component's own tree, and the attribute the
// stylesheets select on.
//
// **THE THEME IS A COOKIE, NOT A QUERY PARAMETER, AND THAT IS THE DECISION THIS FILE IS MADE OF.**
// A choice in the address bar is a choice about *that page*; a reader who prefers dark wants it on
// every page, without asking again -- which is what a cookie is for and a query string is not. The
// **server** reads its own cookie and seeds a fresh atom for the request (see the README); the
// **client** writes the cookie back when the reader changes it, so the choice outlives the tab and
// the very next request already renders the right colour -- there is nothing to flash and nothing
// for a hydrating page to correct.
//
// **The atom is the only source of truth once seeded.** `useTheme()` reads and writes it directly
// and needs no `Theme` above it to do either.

import { createElement, Fragment, atom, useAtom, useEffect, useRef, style } from lath
import { setCookie } from slate:dom

import tokens from "./tokens.css"
import sheet from "./theme.css"
import { choice, classes, maybeFn, list } from "./props.sl"

// The two words, in one place, so that a message listing them cannot drift from the check.
export val Themes = ["light", "dark"]

// Every `Theme` and every `useTheme()` reads and writes this one atom -- module-level, so a
// component with no `Theme` above it still has somewhere to read from.
export val themeAtom = atom("light")

// A value that is not one of the two words displays as "light" and never faults -- an atom, unlike
// a prop, is not something this component can refuse on the caller's behalf.
resolved(value) =
    if Themes.indexOf(value) != null then value else "light"

// The theme, and a way to change it.
//
//     val [theme, setTheme] = useTheme()
//
// **It is a hook.** `useAtom` keeps a slot, so unlike the old context form it may not be called
// inside a condition.
export useTheme() -> array = useAtom(themeAtom)

// The provider, and the element every stylesheet in this package selects a dark page on.
//
// **The `theme` prop SEEDS the atom; it does not control it.** Handing it in writes the atom once,
// on this instance's first render -- and every render after that, including this very prop staying
// the same on a later pass and a later `useTheme()` toggle from anywhere in the tree, reads the
// atom's own value. That is what makes the one component right on a server, which renders once and
// never toggles, and on a page, which never stops: a page hydrated with the cookie's value does not
// fight a reader who then toggles it.
//
// | | |
// |---|---|
// | `<Theme>` with no `theme` | the atom, as it stands -- `"light"` until something seeds or sets it |
// | `<Theme theme={…} onChange={…}>` | the caller's value, read once off a cookie the server saw |
//
// **`onChange`, where given, is called only on an actual later change** -- from a `useTheme()`
// toggle anywhere in the tree below. It is never called for the seed and never called on mount,
// so an application reaching a server route to persist a choice does not post on every page load;
// see the README for what a page does with it.
export theme({ theme = null, onChange = null, class: extra = "", children = [] }) =
    style(tokens)
    style(sheet)

    val given = if theme == null then null else choice("Theme", "theme", theme, Themes)
    val handler = maybeFn("Theme", "onChange", onChange)
    val kids = list("Theme", "children", children)

    val [held, setHeld] = useAtom(themeAtom)
    val seeded = useRef(false)
    val isFirst = !seeded.current

    if isFirst
        seeded.current = true

        if given != null && given != held
            setHeld(given)

    val now = if isFirst && given != null then given else resolved(held)

    val mounted = useRef(false)

    // **The cookie write shares the mount guard with `onChange`** -- never for the seed and never
    // for a prop staying the same, only for a later `useTheme()` toggle. `setCookie` is `slate:dom`'s
    // and every one of that module's names faults under the interpreter and under a server that is
    // not a browser, so the call is guarded by `host()`, the one global every host answers directly
    // -- exactly as `docs/library/dom.md` says a shared file with no control over where it runs
    // should. A real browser, and the jsdom document the DOM suite installs, both answer
    // `"browser"`; anywhere else the write is simply not there to make, exactly like the `onChange`
    // this sits beside.
    notify() =
        if mounted.current
            if handler != null then handler(now)

            if host() == "browser"
                setCookie("theme", now, { path: "/", maxAge: 31536000, sameSite: "Lax" })

        mounted.current = true

        null

    useEffect(notify, [now])

    <div class={classes("Theme", "mortar", extra)} data-theme={now}>{kids}</div>
